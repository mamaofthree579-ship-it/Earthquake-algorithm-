import pandas as pd
from predictive.engine import train_demo_model, features_from_harmonics, _mags_to_harmonics_df

df = st.session_state["quakes"] # your real-time frame
X, y = [], []
for i in range(120, len(df)):
    win = df["magnitude"].iloc[i-120:i].tolist()
    feats = features_from_harmonics(_mags_to_harmonics_df(win))
    X.append(feats.iloc[0])
    y.append(1 if df["magnitude"].iloc[i] > 5.5 else 0)

train_demo_model(pd.DataFrame(X), pd.Series(y))
